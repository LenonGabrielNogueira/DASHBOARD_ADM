# Exemplo para desenvolvimento — NÃO INSERIR CREDENCIAIS REAIS
# Verificar nomes e integrações já presentes no projeto antes de usar.
# Campos vazios são intencionais; preencha somente no ambiente local privado.

# PostgreSQL/Neon: conexão da aplicação, normalmente com pooler.
DATABASE_URL=
# Conexão direta exigida pelo schema Prisma atual para ferramentas/migrations.
# Documentar esta variável não autoriza executar operações de banco.
DIRECT_URL=

# Clerk: chave publicável da aplicação, destinada à integração no navegador.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Clerk: chave secreta, usada exclusivamente no servidor.
CLERK_SECRET_KEY=
# IDs de usuários autorizados como admin, separados por vírgula; usados só no servidor.
ADMIN_USER_IDS=

# A configuração da organização operacional será definida em tarefa futura.
